<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.woongs.tokmo-stockbot-inbox</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/home/tokmo/.hermes/scripts/tokmo_stockbot_inbox.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/home/tokmo/tokmo-v3/var/data/ops/stockbot-inbox/stderr.log</string>
	<key>StandardOutPath</key>
	<string>/home/tokmo/tokmo-v3/var/data/ops/stockbot-inbox/stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/home/tokmo/tokmo-v3</string>
</dict>
</plist>
