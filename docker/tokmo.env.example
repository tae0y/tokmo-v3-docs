# Copy to docker/tokmo.env (gitignored) and fill in. Values are read as container environment variables.
# Stock-bot dialogue (pulse); on macOS the wrappers read these from ~/.zshrc.
TELEGRAM_STOCK_BOT=
TELEGRAM_CHAT_ID=
# Optional: where fallback failure alerts go.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
