+def news_quota(entry: dict[str, Any], observed: datetime) -> list[dict[str, str]]:
+    windows = entry.get("windows")
+    if (now() - observed).total_seconds() < -120:
+        return [issue("QUOTA_STALE", "provider", "future observation")]
+    if not isinstance(windows, list) or not windows:
+        return [issue("PROVIDER_UNAVAILABLE", "provider")]
+    labels = set()
+    for window in windows:
+        if not isinstance(window, dict):
+            return [issue("PROVIDER_UNAVAILABLE", "provider")]
+        label, value = window.get("label"), window.get("remaining")
+        if not isinstance(label, str) or not label or label in labels or type(value) not in (int, float) or not math.isfinite(value) or not 0 <= value <= 100:
+            return [issue("PROVIDER_UNAVAILABLE", "provider")]
+        labels.add(label)
+        if value == 0:
+            return [issue("QUOTA_EXHAUSTED", "provider")]
+    return [] if "Session" in labels else [issue("PROVIDER_UNAVAILABLE", "provider")]
+
+
+def news_output_error(output: str) -> str | None:
+    try:
+        rows = [json.loads(line) for line in output.splitlines() if line.strip()]
+        messages = []
+        for row in rows:
+            item = row.get("item") or {}
+            # Codex also emits informational CLI warnings as item.type=error.
+            # They are not tools; process exit status still gates success.
+            if item and item.get("type") not in {"reasoning", "agent_message", "error"}:
+                return "NEWS_TOOL_USE_REJECTED"
+            if row.get("type") == "item.completed" and item.get("type") == "agent_message":
+                messages.append(item.get("text"))
+        if not messages or not isinstance(json.loads(messages[-1]), dict):
+            return "NEWS_JSON_RESPONSE_INVALID"
+    except (ValueError, TypeError, AttributeError):
+        return "NEWS_JSON_RESPONSE_INVALID"
+    return None
+
